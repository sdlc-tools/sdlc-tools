{
  "name": "@sdlc-tools/jira",
  "version": "0.2.0",
  "description": "Jira Cloud command-line client designed for people and AI agents: issues, transitions, comments and worklogs, signed in with OAuth 2.0 (3LO) or an API token kept in the OS keychain.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdlc-tools/sdlc-tools.git",
    "directory": "packages/jira"
  },
  "homepage": "https://github.com/sdlc-tools/sdlc-tools/tree/main/packages/jira#readme",
  "bugs": "https://github.com/sdlc-tools/sdlc-tools/issues",
  "keywords": [
    "jira",
    "atlassian",
    "cli",
    "ai-agents",
    "keychain"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "sdlc-jira": "dist/bin.js"
  },
  "exports": {
    ".": {
      "@sdlc-tools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdlc-tools/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
